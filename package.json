{
  "name": "salesforce-team-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Installs a six-role Salesforce Claude Code team, a sandbox-only org guard and a local office dashboard into an SFDX project.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p dashboard && vite build --config dashboard/vite.config.ts",
    "office": "node scripts/office.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p dashboard && tsc -p test/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
